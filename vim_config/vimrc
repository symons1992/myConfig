" Show coc.nvim status, including extension installation progress
set statusline^=%{coc#status()}
 
function! CheckBackspace() abort
	  let col = col('.') - 1
	    return !col || getline('.')[col - 1] =~# '\s'
endfunction
 
" Trigger completion with Tab and navigate the completion menu
inoremap <silent><expr> <TAB>
      \ coc#pum#visible() ? coc#pum#next(1) :
	        \ CheckBackspace() ? "\<Tab>" :
			      \ coc#refresh()
" Shift-Tab reduces indentation when the completion menu is closed.
inoremap <silent><expr> <S-TAB> coc#pum#visible() ? coc#pum#prev(1) : "\<C-d>"
" Enter confirms an explicitly selected item; otherwise it inserts a newline.
inoremap <silent><expr> <CR>
      \ coc#pum#visible() && coc#pum#info()['index'] >= 0
      \ ? coc#pum#confirm()
      \ : (coc#pum#visible() ? coc#pum#stop() : '') . "\<C-g>u\<CR>\<C-r>=coc#on_enter()\<CR>"

" Python completion is provided by Coc, including on Vim without +python3.
augroup editor_python_completion
  autocmd!
  autocmd FileType python inoremap <buffer><silent><expr> <C-f> coc#refresh()
augroup END
inoremap <silent><expr> <C-e> coc#pum#visible() ? coc#pum#cancel() : "\<C-e>"
 
" Diagnostics and code navigation
