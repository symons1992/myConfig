nmap <silent> gd <Plug>(coc-definition)
nmap <silent> gy <Plug>(coc-type-definition)
nmap <silent> gi <Plug>(coc-implementation)

function! s:UrlDecode(str) abort
  return substitute(a:str, '%\x\x', '\=nr2char(str2nr(submatch(0)[1:], 16))', 'g')
endfunction

function! s:CocUriToFile(uri) abort
  return s:UrlDecode(substitute(a:uri, '^file://', '', ''))
endfunction

function! CocReferencesNoTest() abort
  let l:locations = CocAction('references')
  if empty(l:locations)
    echo 'No references'
    return
  endif

  let l:items = []
  for l:loc in l:locations
    let l:file = s:CocUriToFile(get(l:loc, 'uri', get(l:loc, 'targetUri', '')))
    if l:file =~# '\v(_test\.go$|\.(test|spec)\.(js|jsx|ts|tsx)$|/tests?/)' 
      continue
    endif
    let l:range = get(l:loc, 'range', get(l:loc, 'targetSelectionRange', {}))
    let l:start = get(l:range, 'start', {})
    call add(l:items, {
          \ 'filename': l:file,
          \ 'lnum': get(l:start, 'line', 0) + 1,
          \ 'col': get(l:start, 'character', 0) + 1,
          \ 'text': get(readfile(l:file, '', get(l:start, 'line', 0) + 1), get(l:start, 'line', 0), '')
          \ })
  endfor

  if empty(l:items)
    echo 'Only test references found'
    return
  endif

  call setqflist([], ' ', {'title': 'Coc references (no tests)', 'items': l:items})
  if len(l:items) == 1
    cfirst
  else
    copen
  endif
endfunction

nmap <silent> gr :call CocReferencesNoTest()<CR>
